{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vision Studio",
  "version": "1.0.0",
  "identifier": "com.visionstudio.cameraconfig",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vision Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Camera configuration editor",
    "longDescription": "Create, edit, validate and export camera test-bench project configuration JSON files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
